{
  "schemaVersion": 1,
  "id": "lukascaha.planetscale",
  "name": "PlanetScale",
  "version": "1.3.0",
  "author": "LukasCaha",
  "license": "MIT",
  "description": "PlanetScale in the Omarchy bar: state, deploys, latency, query rate, and charts. Pin up to two numbers beside the logo.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "widget.qml"
  },
  "barWidget": {
    "displayName": "PlanetScale",
    "description": "PlanetScale logo. Click for state, deploys, latency, and charts. Pin up to two numbers.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "organization": "",
      "database": "",
      "branch": "main",
      "refreshIntervalSec": 60,
      "barMetrics": ["p99"],
      "metricPeriod": "1h"
    },
    "schema": [
      {
        "key": "organization",
        "type": "string",
        "label": "Organization",
        "description": "PlanetScale organization slug.",
        "defaultValue": ""
      },
      {
        "key": "database",
        "type": "string",
        "label": "Database",
        "description": "Database name slug.",
        "defaultValue": ""
      },
      {
        "key": "branch",
        "type": "string",
        "label": "Branch",
        "description": "Branch whose metrics and query errors are shown.",
        "defaultValue": "main"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 60
      },
      {
        "key": "metricPeriod",
        "type": "enum",
        "label": "Metric range",
        "description": "Latency, query rate, errors, CPU, memory, and replica lag are averages over this range.",
        "options": ["15m", "1h", "6h", "1d", "7d"],
        "defaultValue": "1h"
      }
    ]
  }
}
